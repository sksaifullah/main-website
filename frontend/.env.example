# Frontend Environment Variables — Sky Worldwide
# Copy this file to .env.local and fill in your values.
# NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets here.

# Backend API URL (must include protocol, no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Flask/FastAPI
ENV=development
DEBUG=True
SECRET_KEY=your-secret-key

# Database
DATABASE_URL=sqlite:///data/skyworldwide.db

# FedEx
FEDEX_CLIENT_ID= l7095011b0d0194d758e862b96651380f0
FEDEX_CLIENT_SECRET= d5ac15349aa74835851c0375663a89de

# DHL
DHL_API_KEY=
DHL_API_SECRET=

# UPS
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# Aramex
ARAMEX_USERNAME=
ARAMEX_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret

# CORS
ALLOWED_ORIGIN=http://localhost:3000