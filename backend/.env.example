# Sky Worldwide Backend Environment Variables
# Copy this file to .env and fill in your values.
# This file IS committed to git. The actual .env is git-ignored.

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ── Development ───────────────────────────────────────────────────────────────
# Set to true to bypass login and grant direct dashboard access (dev only).
DEVELOPMENT_MODE=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * for all.
# Example: http://localhost:3000,https://yourdomain.com
CORS_ALLOWED_ORIGINS=*

# ── Auto Sync ─────────────────────────────────────────────────────────────────
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=30

# ── Admin Credentials (used to seed the database on first run) ────────────────
ADMIN_DEFAULT_USERNAME=Admin
ADMIN_DEFAULT_EMAIL=admin@skyworldwide.com
ADMIN_DEFAULT_PASSWORD=sky@123


# Backend API URL (must include protocol, no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Flask/FastAPI
ENV=development
DEBUG=True
SECRET_KEY=your-secret-key

# Database
DATABASE_URL=sqlite:///data/skyworldwide.db

# FedEx
FEDEX_CLIENT_ID= l7095011b0d0194d758e862b96651380f0
FEDEX_CLIENT_SECRET= d5ac15349aa74835851c0375663a89de

# DHL
DHL_API_KEY=
DHL_API_SECRET=

# UPS
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# Aramex
ARAMEX_USERNAME=
ARAMEX_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret

# CORS
ALLOWED_ORIGIN=http://localhost:3000